<?xml version="1.0" encoding="UTF-8"?><edmx:Edmx xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:sap="http://www.sap.com/Protocols/SAPData" Version="1.0">
    <edmx:DataServices xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" m:DataServiceVersion="2.0">
        <Schema xmlns="http://schemas.microsoft.com/ado/2008/09/edm" Namespace="S1">
            <EntityContainer Name="EC1" m:IsDefaultEntityContainer="true">
                <EntitySet EntityType="S1.EntradaSalidaType" Name="EntradaSalidaTypeSet"/>
                <EntitySet EntityType="S1.ProductType" Name="ProductSet"/>
            </EntityContainer>
            <EntityType Name="EntradaSalidaType">
                <Documentation/>
                <Key>
                    <PropertyRef Name="ID"/>
                </Key>
                <Property Name="ID" Nullable="false" Type="Edm.String" sap:filterable="false"/>
                <Property Name="DocumentDate" Nullable="true" Type="Edm.DateTime" sap:display-format="Date" sap:filter-restriction="interval" sap:required-in-filter="true"/>
                <Property MaxLength="40" Name="Material" Nullable="true" Type="Edm.String" sap:filter-restriction="single-value" sap:required-in-filter="true"/>
                <Property MaxLength="20" Name="YY1_Vale_PDI" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property MaxLength="40" Name="ProductDescription" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property MaxLength="3" Name="MaterialBaseUnit" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property MaxLength="80" Name="SupplierName" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property MaxLength="15" Name="NHC" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property MaxLength="6" Name="Orden_Medica" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property MaxLength="9" Name="Medico_Prescriptor" Nullable="true" Type="Edm.String" sap:filterable="false"/>
                <Property Name="GoodsReceiptQtyInBaseUnit" Nullable="true" Precision="31" Scale="0" Type="Edm.Decimal" sap:filterable="false" sap:unit="MaterialBaseUnit"/>
                <Property Name="GoodsIssueQtyInBaseUnit" Nullable="true" Precision="31" Scale="0" Type="Edm.Decimal" sap:filterable="false" sap:unit="MaterialBaseUnit"/>
                <Property Name="Balance" Nullable="true" Precision="31" Scale="0" Type="Edm.Decimal" sap:filterable="false"/>
            </EntityType>
            <EntityType Name="ProductType">
                <Key>
                    <PropertyRef Name="Product"/>
                </Key>
                <Property MaxLength="40" Name="Product" Nullable="false" Type="Edm.String"/>
                <Property MaxLength="40" Name="ProductDescription" Type="Edm.String"/>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>