	<!-- ################################################################# -->
	<!-- # Definicion de tipos de datos complejos                        # -->
	<!-- ################################################################# -->

	<xs:complexType name="_t_cabeceradocumento">
		<xs:sequence>
			<!-- CO_COMUNICACION. Obligatorio -->
			<xs:element name="TipoComunicacion" type="_t_tipocomunicacion"/>
			<xs:choice>
				<xs:element name="IdentificacionCas" type="_t_identificacioncas" minOccurs="0"/>
				<xs:element name="IdentificacionSin" type="_t_identificacionsin" minOccurs="0"/>
				<xs:element name="IdentificacionFaf" type="_t_identificacionfaf" minOccurs="0"/>
				<xs:element name="IdentificacionFas" type="_t_identificacionfas" minOccurs="0"/>
			</xs:choice>
			<!-- OBSERVACIONES -->
			<xs:element name="Observaciones" type="_t_texto" minOccurs="0"/>
			<!-- CO_CENTRO o CO_ENTIDAD -->
			<xs:element name="CentroEmisor" type="_t_codigocs" minOccurs="0"/>
			<!-- CO_EMISOR -->
			<xs:element name="Emisor" type="_t_centro" minOccurs="0"/>
			<!-- Valor 'S' o 'N'. Salida -->
			<xs:element name="InformacionAdicional" type="_t_infoadicional" minOccurs="0"/>
			<!-- MATRICULA_FIVA. Salida -->
			<xs:element name="MatriculaFIVA" type="_t_matriculafiva" minOccurs="0"/>
			<!-- FE_ENVIO from CAS_COMUNICACION. Salida -->
			<xs:element name="FechaEnvio" type="xs:date" minOccurs="0"/>
			<!-- salida -->
			<xs:element name="CodError" type="_t_coderror" minOccurs="0"/>
			<!-- salida -->
			<xs:element name="Error" type="_t_texto2_1024" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="_t_identificacioncas">
		<xs:sequence>
			<!-- CO_EXPEDIENTE. Obligatorio -->
			<xs:element name="CodExpedienteCAS" type="_t_identificador1"/>
                        <!-- CO_CONVENIO -->
                        <xs:element name="Convenio" type="_t_convenio" minOccurs="0"/>
			<!-- CO_CENTRO o CO_ENTIDAD. Salida -->
			<xs:element name="CentroReceptor" type="_t_codigocs" minOccurs="0"/>
			<!-- FE_SINIESTRO. Salida -->
			<xs:element name="FechaSiniestro" type="xs:date" minOccurs="0"/>
			<!-- MATRICULA. Salida -->
			<xs:element name="MatriculaVehiculo" type="_t_matricula" minOccurs="0"/>
			<!-- ID_LESIONADO_CS. Salida -->
			<xs:element name="IdLesionadoCentroHospitalario" type="_t_identificador2" minOccurs="0"/>
			<!-- DE_CENTRO. Salida -->
			<xs:element name="DelegacionCentroSanitario" type="_t_delegacion" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

