  <xs:simpleType name="_t_matricula2">
    <xs:restriction base="xs:token">
      <xs:minLength value="0"/>
      <xs:maxLength value="12"/>
    </xs:restriction>
  </xs:simpleType>

	<xs:simpleType name="_t_matriculafiva">
		<xs:restriction base="xs:string">
			<!-- Ordinarias -->
			<xs:pattern value="  [0-9]{4}[B-DF-HJ-NP-PR-TV-Z]{3}" />
			<xs:pattern value="  [A-Z][A-Z ](00[0-9]{4}[ A-Z][A-Z]|0[1-9][0-9]{4}|[1-9][0-9]{5})" />
			<!-- Especiales -->
			<xs:pattern value="E [A-Z][A-Z ][0-9]{6}VE" />
 			<xs:pattern value="E1E[0-9]{4}[B-DF-HJ-NP-TV-Z]{3}" />
			<!-- Remolques -->
 			<xs:pattern value="R [A-Z][A-Z ][0-9]{6}R" />
			<xs:pattern value="R1R[0-9]{4}[B-DF-HJ-NP-TV-Z]{3}" />
	 		<!-- Ciclomotor -->
		 	<xs:pattern value="C C[0-9]{4}[B-DF-HJ-NP-TV-Z]{3}" />
 			<!-- Diplomatica -->
		 	<xs:pattern value="D (CD|OI|TA|CC)[0-9]{6}" />
		 	<!-- Turistica -->
	 		<xs:pattern value="T [0-9]{2}[A-Z][A-Z ]([0-9]{8}|[0-9]{4}|[0-9]{4}    )" />
	 		<xs:pattern value="T1T[0-9]{4}[B-DF-HJ-NP-TV-Z]{3}" />
		 	<!-- Historica -->
 			<xs:pattern value="H H[0-9]{4}[B-DF-HJ-NP-TV-Z]{3}" />
		 	<!-- Temporal -->
		 	<xs:pattern value="TE[A-Z][A-Z ][0-9]{4}[RT][0-9]{2}" />
	 		<xs:pattern value="TT[PSV][0-9]{4}[B-DF-HJ-NP-TV-Z]{3}" />
		 	<!-- Pruebas TP -->
		 	<xs:pattern value="P [A-Z][A-Z ][0-9]{2}[PT][0-9]{4}([12][0-9]{2}|[12]|[12]  )" />
	 		<!-- ITV -->
	 		<xs:pattern value="I [A-Z][A-Z ]ITV[0-9]{4}" />
			<!-- Vehiculo oficial -->
			<xs:pattern value="M [A-Z](  |[A-Z][A-Z ])(00[0-9]{4}[ A-Z][A-Z]|0[1-9][0-9]{4}|[1-9][0-9]{5})" />
	 		<xs:pattern value="M1[A-Z](  |[A-Z][A-Z ])(VE|  )[0-9]{6}" />
			<!-- Otras -->
			<xs:pattern value="K .+" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="_t_nif">
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:maxLength value="10"/>
