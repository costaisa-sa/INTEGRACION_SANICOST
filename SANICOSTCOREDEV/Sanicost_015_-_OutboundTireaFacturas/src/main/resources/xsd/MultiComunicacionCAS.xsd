			<!-- CO_CENTRO o CO_ENTIDAD. Obligatorio -->
			<xs:element name="CentroReceptor" type="_t_codigocs" />
			<!-- FE_SINIESTRO from CAS_EXPEDIENTE. Obligatorio -->
			<xs:element name="FechaSiniestro" type="xs:date"/>
			<!-- MATRICULA. Obligatorio -->
			<xs:element name="MatriculaVehiculo" type="_t_matricula"/>
			<!-- ID_LESIONADO_CS. Obligatorio -->
