<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="urn:hl7-org:v2xml" xmlns:hl7="urn:hl7-org:v2xml" targetNamespace="urn:hl7-org:v2xml" version="1.1">
	<xsd:element name="MSH" type="xsd:string"/>
	<xsd:element name="SFT" type="xsd:string"/>
	<xsd:element name="UAC" type="xsd:string"/>
	<xsd:element name="DSC" type="xsd:string"/>
	<xsd:element name="PID" type="xsd:string"/>
	<xsd:element name="PD1" type="xsd:string"/>
	<xsd:element name="NTE" type="xsd:string"/>
	<xsd:element name="NK1" type="xsd:string"/>
	<xsd:element name="OBX" type="xsd:string"/>
	<xsd:element name="PV1" type="xsd:string"/>
	<xsd:element name="PV2" type="xsd:string"/>
	<xsd:element name="ORC" type="xsd:string"/>
	<xsd:element name="OBR" type="xsd:string"/>
	<xsd:element name="ROL" type="xsd:string"/>
	<xsd:element name="CTD" type="xsd:string"/>
	<xsd:element name="FT1" type="xsd:string"/>
	<xsd:element name="CTI" type="xsd:string"/>
	<xsd:element name="TQ1" type="xsd:string"/>
	<xsd:element name="TQ2" type="xsd:string"/>
	<xsd:element name="SPM" type="xsd:string"/>
	<xsd:complexType name="ORU_R01.CONTENT">
		<xsd:sequence>
			<xsd:element ref="MSH" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="SFT" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="UAC" minOccurs="0" maxOccurs="1"/>
			<xsd:element ref="ORU_R01.PATIENT_RESULT" minOccurs="1" maxOccurs="unbounded"/>
			<xsd:element ref="DSC" minOccurs="0" maxOccurs="1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01" type="ORU_R01.CONTENT"/>
	<xsd:complexType name="ORU_R01.PATIENT_RESULT.CONTENT">
		<xsd:sequence>
			<xsd:element ref="ORU_R01.PATIENT" minOccurs="0" maxOccurs="1"/>
			<xsd:element ref="ORU_R01.ORDER_OBSERVATION" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.PATIENT_RESULT" type="ORU_R01.PATIENT_RESULT.CONTENT"/>
	<xsd:complexType name="ORU_R01.PATIENT.CONTENT">
		<xsd:sequence>
			<xsd:element ref="PID" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="PD1" minOccurs="0" maxOccurs="1"/>
			<xsd:element ref="NTE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="NK1" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="OBX" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="ORU_R01.VISIT" minOccurs="0" maxOccurs="1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.PATIENT" type="ORU_R01.PATIENT.CONTENT"/>
	<xsd:complexType name="ORU_R01.VISIT.CONTENT">
		<xsd:sequence>
			<xsd:element ref="PV1" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="PV2" minOccurs="0" maxOccurs="1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.VISIT" type="ORU_R01.VISIT.CONTENT"/>
	<xsd:complexType name="ORU_R01.ORDER_OBSERVATION.CONTENT">
		<xsd:sequence>
			<xsd:element ref="ORC" minOccurs="0" maxOccurs="1"/>
			<xsd:element ref="OBR" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="NTE" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="ROL" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="ORU_R01.TIMING_QTY" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="CTD" minOccurs="0" maxOccurs="1"/>
			<xsd:element ref="ORU_R01.OBSERVATION" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="FT1" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="CTI" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element ref="ORU_R01.SPECIMEN" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.ORDER_OBSERVATION" type="ORU_R01.ORDER_OBSERVATION.CONTENT"/>
	<xsd:complexType name="ORU_R01.TIMING_QTY.CONTENT">
		<xsd:sequence>
			<xsd:element ref="TQ1" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="TQ2" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.TIMING_QTY" type="ORU_R01.TIMING_QTY.CONTENT"/>
	<xsd:complexType name="ORU_R01.OBSERVATION.CONTENT">
		<xsd:sequence>
			<xsd:element ref="OBX" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="NTE" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.OBSERVATION" type="ORU_R01.OBSERVATION.CONTENT"/>
	<xsd:complexType name="ORU_R01.SPECIMEN.CONTENT">
		<xsd:sequence>
			<xsd:element ref="SPM" minOccurs="1" maxOccurs="1"/>
			<xsd:element ref="OBX" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="ORU_R01.SPECIMEN" type="ORU_R01.SPECIMEN.CONTENT"/>
</xsd:schema>