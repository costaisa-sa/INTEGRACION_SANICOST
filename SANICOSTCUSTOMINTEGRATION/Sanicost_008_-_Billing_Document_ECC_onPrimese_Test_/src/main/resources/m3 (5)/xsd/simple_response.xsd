<?xml version="1.0" encoding="UTF-8"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">
    <xs:element name="Response">
        <xs:complexType>
          <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="BillingDocument">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="ReferenceDocument" type="xs:string"/>
                  <xs:element name="BillingDocument" type="xs:string"/>
                  <xs:element name="CreationDateTime" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="BillingDocumentFailed">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="ReferenceDocument" type="xs:string"/>
                  <xs:element name="ReferenceDocumentItem" type="xs:string"/>
                  <xs:element maxOccurs="unbounded" minOccurs="0" name="Item">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="TypeID" type="xs:string"/>
                        <xs:element name="SeverityCode" type="xs:string"/>
                        <xs:element name="Note" type="xs:string"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="ID" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>