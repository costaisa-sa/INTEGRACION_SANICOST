<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
    <xs:element name="BillingDocument">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ID"></xs:element>
                <xs:element name="CreationDateTime"></xs:element>
                <xs:element name="ReferenceDocumentLogicalSystem"></xs:element>
                <xs:element name="ReferenceDocument"></xs:element>
                <xs:element name="BillableDocumentItem" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="ReferenceDocumentItem"></xs:element>
                            <xs:element name="BillingDocumentItemText"></xs:element>
                            <xs:element name="SalesOrganization"></xs:element>
                            <xs:element name="DistributionChannel"></xs:element>
                            <xs:element name="Division"></xs:element>
                            <xs:element name="BillingDocumentDate"></xs:element>
                            <xs:element name="SoldToParty"></xs:element>
                            <xs:element name="BillToParty"></xs:element>
                            <xs:element name="PayerParty"></xs:element>
                            <xs:element name="PlanCoberturaID"></xs:element>
                            <xs:element name="PMP0Price"></xs:element>
                            <xs:element name="PacienteExtID"></xs:element>
                            <xs:element name="Material"></xs:element>
                            <xs:element name="Plant"></xs:element>
                            <xs:element name="Quantity"></xs:element>
                            <xs:element name="PricingElement" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="ConditionType"></xs:element>
                                        <xs:element name="ConditionRateValue"></xs:element>
                                        <xs:element name="ConditionQuantity" minOccurs="0" maxOccurs="1"></xs:element>
                                        <xs:element name="ConditionCurrency" minOccurs="0" maxOccurs="1"></xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ProfitCenter"></xs:element>
                            <xs:element name="YY1_SDHISTORIA"></xs:element>
                            <xs:element name="YY1_SDPACIENTE"></xs:element>
                            <xs:element name="YY1_SDFECHAACTIVIDAD"></xs:element>
                            <xs:element name="YY1_REFERENCIA_FACTURA"></xs:element>
                            <xs:element name="YY1_CODIGO_MEDICO"></xs:element>
                            
                            <xs:element name="edificio_OData" minOccurs="0"></xs:element>
                            <xs:element name="servicio_OData" minOccurs="0"></xs:element>
                            <xs:element name="gfh_OData" minOccurs="0"></xs:element>
                            <xs:element name="DescPrestaExt" minOccurs="0"></xs:element>

                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>